+# Deployment mode. Set to "production" on the real server — this activates
+# strict startup checks on JWT_SECRET_KEY and ADMIN_PASSWORD_HASH below.
+ENVIRONMENT=development
+
+# Auth
+# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
+# Required (32+ random chars) when ENVIRONMENT=production, or the app will
+# refuse to start.
+JWT_SECRET_KEY=change-this-in-production
+
+# Administrator login. Generate the hash with:
+# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
+ADMIN_USERNAME=admin
