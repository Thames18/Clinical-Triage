+from pydantic import model_validator
 from pydantic_settings import BaseSettings, SettingsConfigDict
 
+INSECURE_JWT_SECRETS = {"", "change-this-in-production", "secret", "changeme", "supersecret"}
+MIN_JWT_SECRET_LENGTH = 32
+
 
 class Settings(BaseSettings):
+    ENVIRONMENT: str = "development"
+
     OPENAI_API_KEY: str = ""
     ANTHROPIC_API_KEY: str = ""
 
@@ -18,4 +24,25 @@ class Settings(BaseSettings):
         env_file_encoding="utf-8",
     )
 
+    @model_validator(mode="after")
+    def _require_secure_secrets_in_production(self) -> "Settings":
+        if self.ENVIRONMENT.lower() != "production":
+            return self
+
+        if (
+            self.JWT_SECRET_KEY in INSECURE_JWT_SECRETS
+            or len(self.JWT_SECRET_KEY) < MIN_JWT_SECRET_LENGTH
+        ):
+            raise ValueError(
+                "JWT_SECRET_KEY must be a strong random secret of at least "
+                f"{MIN_JWT_SECRET_LENGTH} characters when ENVIRONMENT=production. "
+                'Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"'
+            )
+
+        if not self.ADMIN_PASSWORD_HASH:
+            raise ValueError("ADMIN_PASSWORD_HASH must be set when ENVIRONMENT=production.")
+
+        return self
+
+
 settings = Settings()
